+/**
+ * iOS's own picture in picture window for the call (AVKit's video call
+ * picture in picture): when the app goes to the background mid-call, a
+ * floating window keeps showing the participant on stage, which the user can
+ * move, resize and tap to come back. JS (react/features/mobile/system-pip)
+ * turns it on and says whom to show; JitsiMeetView says which view the call is
+ * drawn in, where the window grows from and returns to.
+ */
+@interface JMSystemPictureInPicture : NSObject
+
+/** A JitsiMeetView moved into or out of a window. */
++ (void)callViewDidMoveToWindow:(UIView *)view;
+
+@end
