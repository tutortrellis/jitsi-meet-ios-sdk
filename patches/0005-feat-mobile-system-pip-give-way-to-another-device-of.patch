 /**
- * Whether the window may open now: in a conference, with it enabled.
+ * Who we are by our ticket (the JWT's context.user): the id the app gives the
+ * same person on each of their devices, and whether this is their second
+ * device (device: 'second'), and since when they made it their main one
+ * (primarySince: an explicit switch in the app, in seconds), if they did.
+ */
+interface IOwnIdentity {
+    id?: string;
+    primarySince?: number;
+    second: boolean;
+}
+
+/**
+ * A ticket's claim to be the person's main device (context.user.primarySince:
+ * seconds; a string once it has come through presence), or undefined.
+ *
+ * @param {unknown} value - The claim as found.
+ * @returns {number|undefined}
+ */
+function claimOf(value: unknown): number | undefined {
+    const since = typeof value === 'number' || typeof value === 'string' ? Number(value) : NaN;
+
+    return Number.isFinite(since) && since > 0 ? since : undefined;
+}
+
+let ownIdentityCache: { identity: IOwnIdentity; jwt?: string; } | undefined;
+
+/**
+ * Who we are by our ticket.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {IOwnIdentity}
+ */
+function getOwnIdentity(state: IReduxState): IOwnIdentity {
+    const { jwt } = state['features/base/jwt'];
+
+    let cache = ownIdentityCache;
+
+    if (!cache || cache.jwt !== jwt) {
+        let user: { device?: unknown; id?: unknown; primarySince?: unknown; } | undefined;
+
+        try {
+            user = jwt ? (jwtDecode(jwt) as { context?: { user?: typeof user; }; }).context?.user : undefined;
+        } catch {
+            user = undefined;
+        }
+        cache = ownIdentityCache = {
+            jwt,
+            identity: {
+                id: typeof user?.id === 'string' && user.id ? user.id : undefined,
+                primarySince: claimOf(user?.primarySince),
+                second: user?.device === 'second'
+            }
+        };
+    }
+
+    return {
+        ...cache.identity,
+        id: cache.identity.id ?? getLocalParticipant(state)?.jwtId
+    };
+}
+
+/**
+ * Whether we give way to another device of ours in the call: the same person
+ * (the same id in their ticket, which the server puts in each participant's
+ * presence: Prosody's presence_identity) with their camera on. Then the window
+ * stays closed here (and closes if it's showing), since that device is where
+ * they are, and our camera goes off in the background as usual. A main device
+ * (signed in) never gives way to a second-device link (an iPhone over the
+ * desk), only to another main one, such as their computer; a second device
+ * gives way to either. Above both: a device the person made their main one
+ * (primarySince in its ticket, from the app's explicit switch) never gives way
+ * to a device of theirs with no such claim or an older one, so the latest
+ * switch wins. The claim only comes from signed tickets (ours, and the others'
+ * through Prosody's presence_identity, which no client can set). Without
+ * identities in presence nobody is matched, and the window works as before.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {boolean}
+ */
+export function givesWayToOwnOtherDevice(state: IReduxState): boolean {
+    const own = getOwnIdentity(state);
+
+    if (!own.id) {
+        return false;
+    }
+
+    for (const participant of getRemoteParticipants(state).values()) {
+        const context = participant.userContext;
+
+        if (participant.fakeParticipant || context?.id !== own.id || (!own.second && context?.device === 'second')) {
+            continue;
+        }
+
+        const theirs = claimOf(context?.primarySince);
+
+        if (own.primarySince !== undefined && (theirs === undefined || theirs < own.primarySince)) {
+            continue;
+        }
+
+        const track = getVideoTrackByParticipant(state, participant);
+
+        if (track && !track.muted && track.videoType !== VIDEO_TYPE.DESKTOP) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+/**
+ * Whether the window may open now: in a conference, with it enabled, unless we
+ * give way to another device of ours with its camera on.
  *
  * @param {IReduxState} state - The redux state.
  * @returns {boolean}
  */
 export function isSystemPipAllowed(state: IReduxState): boolean {
-    return isSystemPipEnabled(state) && Boolean(getCurrentConference(state));
+    return isSystemPipEnabled(state) && Boolean(getCurrentConference(state)) && !givesWayToOwnOtherDevice(state);
 }
 
