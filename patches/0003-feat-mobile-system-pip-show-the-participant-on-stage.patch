diff --git a/react/features/mobile/system-pip/middleware.ts b/react/features/mobile/system-pip/middleware.ts
new file mode 100644
index 000000000..2480d49a3
--- /dev/null
+++ b/react/features/mobile/system-pip/middleware.ts
@@ -0,0 +1,72 @@
+import { NativeEventEmitter, NativeModules } from 'react-native';
+
+import { APP_WILL_MOUNT, APP_WILL_UNMOUNT } from '../../base/app/actionTypes';
+import { getCurrentConference } from '../../base/conference/functions';
+import MiddlewareRegistry from '../../base/redux/MiddlewareRegistry';
+import StateListenerRegistry from '../../base/redux/StateListenerRegistry';
+
+import { systemPipActiveChanged } from './actions';
+import { getSystemPipSource, isSystemPipEnabled } from './functions';
+import logger from './logger';
+
+const { SystemPictureInPicture } = NativeModules;
+
+/**
+ * The subscription to the native module's "window opened / closed" event.
+ */
+let subscription: { remove: Function; } | undefined;
+
+/**
+ * Hears when iOS's picture in picture window opens and closes (the last N
+ * middleware keeps the participant on stage coming while it shows).
+ *
+ * @param {Store} store - The redux store.
+ * @returns {Function}
+ */
+MiddlewareRegistry.register(store => next => action => {
+    switch (action.type) {
+    case APP_WILL_MOUNT:
+        if (SystemPictureInPicture && !subscription) {
+            subscription = new NativeEventEmitter(SystemPictureInPicture).addListener(
+                SystemPictureInPicture.ACTIVE_CHANGED_EVENT,
+                ({ active }: { active: boolean; }) => {
+                    logger.info(`System picture in picture ${active ? 'shown' : 'closed'}`);
+                    store.dispatch(systemPipActiveChanged(active));
+                });
+        }
+        break;
+
+    case APP_WILL_UNMOUNT:
+        subscription?.remove();
+        subscription = undefined;
+        break;
+    }
+
+    return next(action);
+});
+
+/**
+ * The window is available while in a conference with the feature flag on, and
+ * goes when the conference ends (closing it if it's showing).
+ */
+StateListenerRegistry.register(
+    /* selector */ state => isSystemPipEnabled(state) && Boolean(getCurrentConference(state)),
+    /* listener */ (enabled: boolean) => {
+        logger.info(`System picture in picture ${enabled ? 'enabled' : 'disabled'}`);
+        SystemPictureInPicture?.setEnabled(enabled);
+    }
+);
+
+/**
+ * Who the window shows, kept up to date as the participant on stage, their
+ * video and their name change.
+ */
+StateListenerRegistry.register(
+    /* selector */ state => (isSystemPipEnabled(state) && getCurrentConference(state)
+        ? getSystemPipSource(state) ?? null
+        : null),
+    /* listener */ source => SystemPictureInPicture?.setSource(source),
+    {
+        deepEquals: true
+    }
+);
diff --git a/react/features/mobile/system-pip/reducer.ts b/react/features/mobile/system-pip/reducer.ts
new file mode 100644
index 000000000..d75c51520
--- /dev/null
+++ b/react/features/mobile/system-pip/reducer.ts
@@ -0,0 +1,28 @@
+import ReducerRegistry from '../../base/redux/ReducerRegistry';
+
+import { SYSTEM_PIP_ACTIVE_CHANGED } from './actionTypes';
+
+export interface ISystemPipState {
+
+    /**
+     * Whether iOS's own picture in picture window is showing the call.
+     */
+    active: boolean;
+}
+
+const DEFAULT_STATE: ISystemPipState = {
+    active: false
+};
+
+ReducerRegistry.register<ISystemPipState>('features/mobile/system-pip',
+    (state = DEFAULT_STATE, action): ISystemPipState => {
+        switch (action.type) {
+        case SYSTEM_PIP_ACTIVE_CHANGED:
+            return {
+                ...state,
+                active: Boolean(action.active)
+            };
+        }
+
+        return state;
+    });
