+import { SYSTEM_PIP_ACTIVE_CHANGED } from './actionTypes';
+
+/**
+ * Records whether iOS's own picture in picture window is showing the call.
+ *
+ * @param {boolean} active - Whether the window is showing.
+ * @returns {{
+ *     type: SYSTEM_PIP_ACTIVE_CHANGED,
+ *     active: boolean
+ * }}
+ */
+export function systemPipActiveChanged(active: boolean) {
+    return {
+        type: SYSTEM_PIP_ACTIVE_CHANGED,
+        active
+    };
+}
diff --git a/react/features/mobile/system-pip/functions.ts b/react/features/mobile/system-pip/functions.ts
new file mode 100644
index 000000000..d77d94f59
--- /dev/null
+++ b/react/features/mobile/system-pip/functions.ts
@@ -0,0 +1,142 @@
+import { NativeModules, Platform } from 'react-native';
+
+import { IReduxState } from '../../app/types';
+import { getAvatarColor, getInitials } from '../../base/avatar/functions';
+import { IOS_SYSTEM_PIP_ENABLED } from '../../base/flags/constants';
+import { getFeatureFlag } from '../../base/flags/functions';
+import { JitsiTrackStreamingStatus } from '../../base/lib-jitsi-meet';
+import { VIDEO_TYPE } from '../../base/media/constants';
+import {
+    getDominantSpeakerParticipant,
+    getParticipantById,
+    getParticipantDisplayName,
+    getRemoteParticipants,
+    isRemoteScreenshareParticipant,
+    isScreenShareParticipant
+} from '../../base/participants/functions';
+import { IParticipant } from '../../base/participants/types';
+import { getVideoTrackByParticipant } from '../../base/tracks/functions';
+
+/**
+ * What iOS's picture in picture window shows: the participant's video while it
+ * comes through, otherwise who they are.
+ */
+export interface ISystemPipSource {
+
+    /**
+     * Their avatar colour, as the call's avatars have it.
+     */
+    color: string;
+
+    /**
+     * Their initials, as the call's avatars have them.
+     */
+    initials: string;
+
+    /**
+     * Their name.
+     */
+    name: string;
+
+    /**
+     * The video's stream (react-native-webrtc's stream URL), while it comes
+     * through.
+     */
+    streamURL?: string;
+
+    /**
+     * Whether there's video to show.
+     */
+    video: boolean;
+}
+
+/**
+ * Whether iOS's own picture in picture window is in use: iOS only, on devices
+ * that have it, and only when the app asks for it with the feature flag.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {boolean}
+ */
+export function isSystemPipEnabled(state: IReduxState): boolean {
+    return Platform.OS === 'ios'
+        && Boolean(NativeModules.SystemPictureInPicture?.SUPPORTED)
+        && Boolean(getFeatureFlag(state, IOS_SYSTEM_PIP_ENABLED, false));
+}
+
+/**
+ * Whether a participant can be the one in the window: someone else (or what
+ * they share), never us, a bot, a whiteboard or a shared video.
+ *
+ * @param {IParticipant|undefined} participant - The participant.
+ * @returns {boolean}
+ */
+function isShowable(participant?: IParticipant): participant is IParticipant {
+    return Boolean(participant
+        && !participant.local
+        && !participant.botType
+        && (!participant.fakeParticipant || isRemoteScreenshareParticipant(participant)));
+}
+
+/**
+ * Who the window shows: the participant on stage (what they share comes on
+ * stage by itself) unless that's us; otherwise the dominant speaker, else the
+ * latest to join with video, else the latest to join.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {IParticipant|undefined}
+ */
+function getSystemPipParticipant(state: IReduxState): IParticipant | undefined {
+    const { participantId } = state['features/large-video'];
+    const onStage = participantId ? getParticipantById(state, participantId) : undefined;
+
+    if (isShowable(onStage)) {
+        return onStage;
+    }
+
+    const speaker = getDominantSpeakerParticipant(state);
+
+    if (isShowable(speaker)) {
+        return speaker;
+    }
+
+    const others = [ ...getRemoteParticipants(state).values() ].filter(isShowable);
+    const withVideo = others.filter(p => getVideoTrackByParticipant(state, p));
+
+    return withVideo[withVideo.length - 1] ?? others[others.length - 1];
+}
+
+/**
+ * What the window should show now, or undefined when there's nobody else in
+ * the call.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {ISystemPipSource|undefined}
+ */
+export function getSystemPipSource(state: IReduxState): ISystemPipSource | undefined {
+    const participant = getSystemPipParticipant(state);
+
+    if (!participant) {
+        return undefined;
+    }
+
+    const track = getVideoTrackByParticipant(state, participant);
+    const screen = isScreenShareParticipant(participant) || track?.videoType === VIDEO_TYPE.DESKTOP;
+    const { enabled: audioOnly } = state['features/base/low-bandwidth-mode'];
+
+    // Muted video, or the bridge not sending it: who they are instead (the window stays open, unlike an RTCView's).
+    const flowing = Boolean(track
+        && !track.muted
+        && track.streamingStatus !== JitsiTrackStreamingStatus.INACTIVE
+        && (!audioOnly || screen));
+    const streamURL: string | undefined = flowing ? track?.jitsiTrack?.getOriginalStream?.()?.toURL?.() : undefined;
+    const name = getParticipantDisplayName(state, participant.id);
+    const initialsBase = participant.name ?? name;
+
+    return {
+        color: getAvatarColor(initialsBase, state['features/dynamic-branding'].avatarBackgrounds ?? []),
+        initials: getInitials(initialsBase),
+        name,
+        streamURL,
+        video: Boolean(streamURL)
+    };
+}
