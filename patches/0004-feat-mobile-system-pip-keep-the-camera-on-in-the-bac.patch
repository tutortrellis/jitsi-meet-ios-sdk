+
+/**
+ * Whether our camera stays on when the app goes to the background, as video
+ * call apps' do: only when the window will show (it may open, with someone in
+ * it) and iOS lets the camera run meanwhile (multitasking camera access).
+ * Otherwise it goes off as the app leaves, as Jitsi's does, also while sharing
+ * the screen (iOS would stop it anyway, leaving the last picture frozen).
+ * Undefined while the window isn't in use: Jitsi's own rule then.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {boolean|undefined}
+ */
+export function shouldKeepCameraInBackground(state: IReduxState): boolean | undefined {
+    if (!isSystemPipEnabled(state) || !getCurrentConference(state)) {
+        return undefined;
+    }
