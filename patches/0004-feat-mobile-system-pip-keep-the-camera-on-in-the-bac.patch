+/**
+ * Whether the capture session behind our camera (the local stream streamURL)
+ * may run while the app is in the background with the window showing: iOS 16's
+ * multitasking camera access, which react-native-webrtc turns on when its
+ * enableMultitaskingCameraAccess option is set and the system allows it (from
+ * iOS 18 for apps with the voip background mode, on iPads with Stage Manager on
+ * an external display, or with Apple's entitlement). Without it iOS stops the
+ * camera as the app leaves.
+ */
+RCT_EXPORT_METHOD(cameraMultitasking:(NSString *)streamURL
+                  resolve:(RCTPromiseResolveBlock)resolve
+                  reject:(RCTPromiseRejectBlock)reject) {
+    WebRTCModule *webrtc = [streamURL isKindOfClass:[NSString class]] ? [self webRTCModule] : nil;
+
+    if (!webrtc) {
+        resolve(@NO);
+
+        return;
+    }
+
+    // Local streams and their capturers belong to WebRTCModule's worker queue.
+    dispatch_async(webrtc.workerQueue, ^{
+        BOOL enabled = NO;
+        RTCVideoTrack *track = webrtc.localStreams[streamURL].videoTracks.firstObject;
+        CaptureController *controller = track.captureController;
+
+        if (@available(iOS 16.0, *)) {
+            if ([controller isKindOfClass:[VideoCaptureController class]]) {
+                AVCaptureSession *session = ((VideoCaptureController *)controller).capturer.captureSession;
+
+                enabled = session.isMultitaskingCameraAccessSupported && session.isMultitaskingCameraAccessEnabled;
+            }
+        }
+        resolve(@(enabled));
+    });
+}
+
 - (nullable WebRTCModule *)webRTCModule {
     id module = [self.moduleRegistry moduleForName:"WebRTCModule"];
 
