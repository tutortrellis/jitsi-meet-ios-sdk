+} from './functions';
 import logger from './logger';
 
 const { SystemPictureInPicture } = NativeModules;
 
+/**
+ * How long after going to the background the window has to open before our
+ * camera goes off after all (it opens as the app leaves).
+ */
+const OPEN_GRACE_MS = 3000;
+
+/**
+ * How long after the window closes in the background before our camera goes
+ * off (the window also closes on the way back into the app).
+ */
+const CLOSE_GRACE_MS = 1500;
+
 /**
  * The subscription to the native module's "window opened / closed" event.
  */
 let subscription: { remove: Function; } | undefined;
 
+/**
+ * A pending check of our camera in the background.
+ */
+let cameraCheck: ReturnType<typeof setTimeout> | undefined;
+
+/**
+ * Our camera was kept on as the app went to the background, for the window:
+ * once the window isn't showing and the app is still away, turn it off as
+ * Jitsi does (iOS stops a camera with no window to show it, leaving a frozen
+ * picture). Coming back into the app turns it on again (base/media).
+ *
+ * @param {Store} store - The redux store.
+ * @param {number} delay - How long to wait first.
+ * @returns {void}
+ */
+function _checkCameraInBackground({ dispatch, getState }: IStore, delay: number) {
+    clearTimeout(cameraCheck);
+    cameraCheck = setTimeout(() => {
+        cameraCheck = undefined;
+
+        const state = getState();
+        const { appState } = state['features/mobile/background'] || {};
+        const { active } = state['features/mobile/system-pip'];
+        // eslint-disable-next-line no-bitwise
+        const backgroundMuted = Boolean(state['features/base/media'].video.muted & VIDEO_MUTISM_AUTHORITY.BACKGROUND);
+
+        if (appState !== 'active' && !active && !backgroundMuted && isSystemPipEnabled(state)) {
+            logger.info('No picture in picture window in the background: camera off');
+            dispatch(setVideoMuted(true, VIDEO_MUTISM_AUTHORITY.BACKGROUND));
+        }
+    }, delay);
+}
+
 /**
  * Hears when iOS's picture in picture window opens and closes (the last N
- * middleware keeps the participant on stage coming while it shows).
+ * middleware keeps the participant on stage coming while it shows), and keeps
+ * our camera on in the background only while the window shows.
  *
  * @param {Store} store - The redux store.
  * @returns {Function}
  */
 MiddlewareRegistry.register(store => next => action => {
+    const result = next(action);
+
     switch (action.type) {
     case APP_WILL_MOUNT:
         if (SystemPictureInPicture && !subscription) {
@@ -39,10 +98,32 @@ MiddlewareRegistry.register(store => next => action => {
     case APP_WILL_UNMOUNT:
         subscription?.remove();
         subscription = undefined;
+        clearTimeout(cameraCheck);
+        cameraCheck = undefined;
+        break;
+
+    case APP_STATE_CHANGED:
+        if (action.appState === 'active') {
+            clearTimeout(cameraCheck);
+            cameraCheck = undefined;
+        } else if (action.appState === 'background' && store.getState()['features/mobile/system-pip'].keepCamera) {
+            _checkCameraInBackground(store, OPEN_GRACE_MS);
+        }
+        break;
+
+    case SYSTEM_PIP_ACTIVE_CHANGED:
+        if (!action.active) {
+            _checkCameraInBackground(store, CLOSE_GRACE_MS);
+        }
+        break;
+
+    case CONFERENCE_LEFT:
+        clearTimeout(cameraCheck);
+        cameraCheck = undefined;
         break;
     }
 
-    return next(action);
+    return result;
 });
 
 /**
@@ -50,7 +131,7 @@ MiddlewareRegistry.register(store => next => action => {
  * goes when the conference ends (closing it if it's showing).
  */
 StateListenerRegistry.register(
-    /* selector */ state => isSystemPipEnabled(state) && Boolean(getCurrentConference(state)),
+    /* selector */ state => isSystemPipAllowed(state),
     /* listener */ (enabled: boolean) => {
         logger.info(`System picture in picture ${enabled ? 'enabled' : 'disabled'}`);
         SystemPictureInPicture?.setEnabled(enabled);
@@ -62,11 +143,37 @@ StateListenerRegistry.register(
  * video and their name change.
  */
 StateListenerRegistry.register(
-    /* selector */ state => (isSystemPipEnabled(state) && getCurrentConference(state)
-        ? getSystemPipSource(state) ?? null
-        : null),
+    /* selector */ state => (isSystemPipAllowed(state) ? getSystemPipSource(state) ?? null : null),
     /* listener */ source => SystemPictureInPicture?.setSource(source),
     {
         deepEquals: true
     }
 );
+
+/**
+ * Whether our camera may keep running while the window shows, asked of its
+ * capture session each time the camera starts (a new stream).
+ */
+StateListenerRegistry.register(
+    /* selector */ state => (isSystemPipEnabled(state) ? getLocalCameraStreamURL(state) : undefined),
+    /* listener */ (streamURL: string | undefined, { dispatch }) => {
+        if (!streamURL || !SystemPictureInPicture?.cameraMultitasking) {
+            return;
+        }
+        SystemPictureInPicture.cameraMultitasking(streamURL)
+            .then((enabled: boolean) => {
+                logger.info(`Camera ${enabled ? 'may' : 'may not'} run with the window showing`);
+                dispatch(systemPipCameraMultitaskingChanged(Boolean(enabled)));
+            })
+            .catch(() => dispatch(systemPipCameraMultitaskingChanged(false)));
+    }
+);
+
+/**
+ * Whether our camera stays on when the app goes to the background (base/media
+ * reads it as the app leaves).
+ */
+StateListenerRegistry.register(
+    /* selector */ state => shouldKeepCameraInBackground(state),
+    /* listener */ (keepCamera: boolean | undefined, { dispatch }) => dispatch(systemPipKeepCameraChanged(keepCamera))
+);
