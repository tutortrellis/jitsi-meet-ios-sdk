 );
 
+/**
+ * Android: tells the app whether its own picture in picture gives way to
+ * another device of ours (the same rule as iOS's window), as the event
+ * PICTURE_IN_PICTURE_GIVE_WAY_CHANGED: while it does, the app doesn't go to
+ * picture in picture as it leaves, and leaves it if it's showing. Nothing is
+ * sent without the feature flag.
+ */
+StateListenerRegistry.register(
+    /* selector */ state => (isGiveWayReported(state)
+        ? Boolean(getCurrentConference(state)) && givesWayToOwnOtherDevice(state)
+        : undefined),
+    /* listener */ (givesWay: boolean | undefined, store) => {
+        if (typeof givesWay !== 'boolean') {
+            return;
+        }
+        logger.info(givesWay
+            ? 'Another device of ours has its camera on: no picture in picture here'
+            : 'No other device of ours with its camera on');
+        sendEvent(store, 'PICTURE_IN_PICTURE_GIVE_WAY_CHANGED', { givesWay });
+    }
+);
+
