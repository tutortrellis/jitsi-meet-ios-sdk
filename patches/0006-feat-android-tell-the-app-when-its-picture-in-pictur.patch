@@ -15,6 +17,7 @@ import {
     getLocalCameraStreamURL,
     getSystemPipSource,
     givesWayToOwnOtherDevice,
+    isGiveWayReported,
     isSystemPipAllowed,
     isSystemPipEnabled,
     shouldKeepCameraInBackground
@@ -137,6 +140,28 @@ StateListenerRegistry.register(
