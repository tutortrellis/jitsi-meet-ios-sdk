 import { getFeatureFlag } from '../../base/flags/functions';
 import { JitsiTrackStreamingStatus } from '../../base/lib-jitsi-meet';
 import { VIDEO_TYPE } from '../../base/media/constants';
@@ -68,6 +68,18 @@ export function isSystemPipEnabled(state: IReduxState): boolean {
         && Boolean(getFeatureFlag(state, IOS_SYSTEM_PIP_ENABLED, false));
 }
 
+/**
+ * Android: whether the app is told when its own picture in picture should give
+ * way to another device of ours (givesWayToOwnOtherDevice). Android's picture
+ * in picture is the app's, so it asks for this with the feature flag.
+ *
+ * @param {IReduxState} state - The redux state.
+ * @returns {boolean}
+ */
+export function isGiveWayReported(state: IReduxState): boolean {
+    return Platform.OS === 'android' && Boolean(getFeatureFlag(state, ANDROID_PIP_GIVE_WAY_ENABLED, false));
+}
