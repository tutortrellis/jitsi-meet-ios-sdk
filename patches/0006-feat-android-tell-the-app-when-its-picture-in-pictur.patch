  */
 export const ANDROID_SCREENSHARING_ENABLED = 'android.screensharing.enabled';
 
+/**
+ * Flag indicating if the app should be told when its own picture in picture
+ * (Android's, which the app runs) should give way to another device of the
+ * same person in the call, by the rule iOS's system picture in picture follows
+ * (the PICTURE_IN_PICTURE_GIVE_WAY_CHANGED event, givesWay: boolean).
+ * Default: disabled (false).
+ */
+export const ANDROID_PIP_GIVE_WAY_ENABLED = 'android.pip-give-way.enabled';
+
 /**
  * Flag indicating if speaker statistics should be enabled.
  * Default: enabled (true).
